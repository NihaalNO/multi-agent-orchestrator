# Copy to .env and fill in. Never commit .env (it is gitignored).
# Every ORCH_* setting is documented in docs/DEPLOYMENT.md.

# Planner: "anthropic" (Claude), "gemini" (Google Gemini), "groq", "ollama" or "rule_based"
# (offline, deterministic). Llama models: use groq or ollama with ORCH_LLM_MODEL set to a Llama model.
ORCH_LLM_PROVIDER=anthropic
# Leave unset to use the provider's default
# (claude-opus-5-5 / gemini-3.8-flash / openai/gpt-oss-120b / gpt-oss:20b).
# ORCH_LLM_MODEL=
# Anthropic only.
ORCH_LLM_EFFORT=medium

# Keys, read by each provider's SDK. Fill in the one(s) you use.
ANTHROPIC_API_KEY=
# Gemini: from Google AI Studio. Needs the gemini extra (included in the Docker image).
GEMINI_API_KEY=
GROQ_API_KEY=
# Ollama runs locally without a key; set ORCH_LLM_BASE_URL for a remote server or its cloud.
# ORCH_LLM_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=

# Web search: "none" (no web search tool), "anthropic" (Claude's server-side web search) or
# "gemini" (Gemini with Google Search grounding). Both are billed per search by the provider.
ORCH_SEARCH_BACKEND=none
# ORCH_SEARCH_MODEL=
ORCH_SEARCH_MAX_USES=3

# Durable state. The Docker image sets ORCH_STATE_PATH=/data/state/orchestrator.db; outside Docker,
# leave unset to keep everything in memory (lost on restart).
# ORCH_STATE_PATH=data/state/orchestrator.db

# Execution limits
ORCH_MAX_CONCURRENCY=8
ORCH_MAX_RETRIES_CAP=3
# ORCH_EXECUTION_DEADLINE_S=120

# Logging: debug | info | warning | error. ORCH_AUDIT_TO_LOG mirrors audit events into the log.
ORCH_LOG_LEVEL=info
ORCH_AUDIT_TO_LOG=false
