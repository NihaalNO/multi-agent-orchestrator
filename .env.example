# Copy to .env and fill in. Never commit .env (it is gitignored).
# Every ORCH_* setting is documented in docs/DEPLOYMENT.md.

# Planner: "anthropic" (Claude) or "rule_based" (offline, deterministic).
ORCH_LLM_PROVIDER=anthropic
ORCH_LLM_MODEL=claude-opus-5-5
ORCH_LLM_EFFORT=medium
# Read by the Anthropic SDK. Required when ORCH_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Web search: "none" (no web search tool) or "anthropic" (Claude's server-side web search, same
# key as the planner; each search is billed on top of tokens).
ORCH_SEARCH_BACKEND=none
ORCH_SEARCH_MAX_USES=3

# Execution limits
ORCH_MAX_CONCURRENCY=8
ORCH_MAX_RETRIES_CAP=3
# ORCH_EXECUTION_DEADLINE_S=120

# Logging: debug | info | warning | error. ORCH_AUDIT_TO_LOG mirrors audit events into the log.
ORCH_LOG_LEVEL=info
ORCH_AUDIT_TO_LOG=false
