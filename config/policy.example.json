{
  "grants": [
    {
      "subject": "role:analyst",
      "tool_id": "uploads",
      "max_access": "write",
      "resources": ["file:users/{user_id}/*"],
      "description": "Upload, list and delete files in your own folder (users/<your id>/)"
    },
    {
      "subject": "role:analyst",
      "tool_id": "file_processing",
      "max_access": "read",
      "resources": ["file:users/{user_id}/*", "file:shared/*"],
      "description": "Read your own files and the shared folder"
    },
    {
      "subject": "role:analyst",
      "tool_id": "file_processing",
      "effect": "deny",
      "resources": ["file:shared/restricted/*"],
      "description": "...except shared/restricted"
    },
    {
      "subject": "role:analyst",
      "tool_id": "web_search",
      "operation": "search",
      "max_access": "read"
    },
    {
      "subject": "role:analyst",
      "tool_id": "python_exec",
      "operation": "run",
      "max_access": "execute",
      "description": "Sandboxed code execution"
    },
    {
      "subject": "role:admin",
      "max_access": "admin",
      "allow_sensitive": true,
      "description": "Everything, including uploading to shared/; sensitive operations still need a separate approver"
    }
  ]
}
